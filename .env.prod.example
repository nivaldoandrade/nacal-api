# Copie para .env.prod e preencha. Nunca commite .env.prod.
# Deploy: AWS_PROFILE=nacal-prod yarn deploy:prod
# O Serverless v4 carrega .env e .env.prod automaticamente com --stage prod.

COGNITO_EMAIL=noreply@nacal.app
COGNITO_EMAIL_TO_REPLY=contato@nacal.app
SES_SOURCE_ARN=arn:aws:ses:sa-east-1:000000000000:identity/nacal.app

APIGATEWAY_DEFAULT_ENDPOINT_DISABLE=true
API_DOMAIN_NAME=api.nacal.app
API_CERTIFICATE_ARN=arn:aws:acm:sa-east-1:000000000000:certificate/SUBSTITUA

# CORS do HTTP API. Em produção, use somente o origin do app.
CORS_ALLOWED_ORIGINS=https://app.nacal.app

# CDN opcional. Se preencher, o certificado precisa estar em us-east-1.
MEALS_CDN_DOMAIN_NAME=
MEALS_CDN_CERTIFICATE_ARN=

DLQ_ALARM_EMAIL=contato@nacal.app

OPENAI_API_KEY=sk-...

# Cloudflare Workers AI (gate de foto). Obrigatório se MEAL_GATE_ENABLED=true.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
MEAL_GATE_ENABLED=true
MEAL_GATE_REJECT_THRESHOLD=0.30

# Beta fechado: true + lista de e-mails. Lançamento público: false.
BETA_GATE_ENABLED=true
BETA_ALLOWED_EMAILS=

GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

ASAAS_BASE_URL=https://api.asaas.com
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Vazio usa a allowlist oficial de produção do Asaas. Nunca use * em produção.
ASAAS_WEBHOOK_ALLOWED_IPS=

APP_WEB_URL=https://app.nacal.app
