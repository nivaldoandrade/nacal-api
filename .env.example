COGNITO_EMAIL=noreply@seudominio
COGNITO_EMAIL_TO_REPLY=suporte@seudominio
SES_SOURCE_ARN=

# Em produção, desabilite o endpoint default depois de configurar o domínio customizado.
# APIGATEWAY_DEFAULT_ENDPOINT_DISABLE=true
API_DOMAIN_NAME=
API_CERTIFICATE_ARN=arn:aws:acm:xxx:xxx:certificate/xxx

# CORS do HTTP API. Vazio libera todas as origens (dev). Em produção: https://app.nacal.app
CORS_ALLOWED_ORIGINS=


#Meals CDN
MEALS_CDN_DOMAIN_NAME=
MEALS_CDN_CERTIFICATE_ARN=

# Alarms
DLQ_ALARM_EMAIL=

# OpenIA
OPENAI_API_KEY=

# Cloudflare Workers AI (gate de foto)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
MEAL_GATE_ENABLED=true
MEAL_GATE_REJECT_THRESHOLD=0.30

# Closed beta allowlist (comma-separated emails, lowercase). Do not commit real emails.
BETA_GATE_ENABLED=false
BETA_ALLOWED_EMAILS=

# Google Provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ASAAS
ASAAS_BASE_URL=https://api-sandbox.asaas.com
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Allowlist de IPs de origem do webhook (separada por vírgula).
# Padrão quando vazia/não setada: IPs oficiais de produção do Asaas
# (52.67.12.206, 18.230.8.159, 54.94.136.112, 54.94.183.101).
# Use * para desabilitar (dev/sandbox, o sandbox pode usar IPs fora da lista).
ASAAS_WEBHOOK_ALLOWED_IPS=

# Origin do web app (Asaas returnUrl e CORS do bucket de refeições).
# Dev: https://192.168.100.21:8443 · Prod: https://app.nacal.app
APP_WEB_URL=
